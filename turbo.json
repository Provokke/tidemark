{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "env": [
        "TIDEMARK_TEST_DATABASE_URL",
        "TIDEMARK_TEST_NATS_URL",
        "TIDEMARK_TEST_KAFKA_BROKERS",
        "TIDEMARK_TEST_S3_ENDPOINT",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "FOUNDRY_SOLC"
      ]
    }
  }
}
