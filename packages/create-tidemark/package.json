{
  "name": "create-tidemark",
  "version": "1.0.1",
  "description": "Scaffolds a Tidemark project from a template, or from a verified contract's ABI (Sourcify or Etherscan).",
  "keywords": [
    "create",
    "scaffold",
    "ethereum",
    "indexer"
  ],
  "license": "MIT",
  "author": "Provokke",
  "homepage": "https://github.com/Provokke/tidemark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/tidemark.git",
    "directory": "packages/create-tidemark"
  },
  "bugs": {
    "url": "https://github.com/Provokke/tidemark/issues"
  },
  "type": "module",
  "bin": {
    "create-tidemark": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "viem": "2.57.15"
  },
  "devDependencies": {
    "@tidemark/cli": "workspace:*",
    "@tidemark/contracts": "workspace:*",
    "@tidemark/engine": "workspace:*",
    "@tidemark/pg": "workspace:*",
    "@tidemark/schema": "workspace:*",
    "@tidemark/testing": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
