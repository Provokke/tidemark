{
  "name": "@tidemark/sync",
  "version": "1.0.1",
  "description": "Tidemark's chain sync: historical sync into the tm_sync cache, keyed by filter and block interval.",
  "keywords": [
    "ethereum",
    "indexer",
    "sync",
    "cache"
  ],
  "license": "MIT",
  "author": "Provokke",
  "homepage": "https://github.com/Provokke/tidemark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/tidemark.git",
    "directory": "packages/sync"
  },
  "bugs": {
    "url": "https://github.com/Provokke/tidemark/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration",
    "fixture:record": "tsx scripts/record-fixture.ts",
    "fixture:anvil": "tsx scripts/generate-anvil-fixture.ts"
  },
  "dependencies": {
    "@tidemark/core": "workspace:*",
    "@tidemark/pg": "workspace:*",
    "@tidemark/rpc": "workspace:*"
  },
  "devDependencies": {
    "@tidemark/contracts": "workspace:*",
    "@tidemark/testing": "workspace:*",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "viem": "2.57.15",
    "vitest": "5.1.0"
  }
}
