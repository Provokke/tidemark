{
  "name": "@tidemark/testing",
  "version": "1.0.1",
  "description": "Test helpers for Tidemark projects: start Anvil, create throwaway Postgres databases, index a project against them, inject RPC faults and reorgs.",
  "keywords": [
    "testing",
    "anvil",
    "vitest"
  ],
  "license": "MIT",
  "author": "Provokke",
  "homepage": "https://github.com/Provokke/tidemark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provokke/tidemark.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/Provokke/tidemark/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "postgres": "4.0.0",
    "viem": "2.57.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
